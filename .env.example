# ==============================================================================
# Potadi Client Service - Environment Configuration Example
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# Backend Hono.js / Better-Auth API Base URL
# Production API: https://api.potadi.sazlab.app
# Local Development API: http://localhost:8000
NUXT_PUBLIC_API_BASE_URL=https://api.potadi.sazlab.app

# Google OAuth Callback URL (Optional: default is relative path "/app")
# If your backend requires absolute callback: e.g. http://localhost:3000/app or http://localhost:8000/api/v1/auth/callback/google
NUXT_PUBLIC_AUTH_CALLBACK_URL=/app

# Nuxt App Port (Optional, default: 3000)
PORT=3000

# Environment Mode
NODE_ENV=development
